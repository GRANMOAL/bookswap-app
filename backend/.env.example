# Copia este archivo a ".env" y ajusta los valores si lo necesitas.

PORT=4000

# Origen permitido para CORS (la URL donde corre el frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Secreto para firmar los tokens JWT (F1 — cámbialo en un entorno real)
JWT_SECRET=bookswap-dev-secret-cambia-esto

# Ruta del archivo de base de datos SQLite
DB_FILE=./data/bookswap.db
